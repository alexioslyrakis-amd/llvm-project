+    %4:av_32 = COPY %1.sub1
+    %5:av_32 = COPY %1.sub0
+    %6:av_128_align2 = DS_READ_B128_gfx9 %0, 4192, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %7:av_32 = COPY %6.sub3
+    %8:av_32 = COPY %6.sub2
+    %9:av_32 = COPY %6.sub1
+    %10:av_32 = COPY %6.sub0
+    %11:av_256_align2 = REG_SEQUENCE %5, %subreg.sub0, %4, %subreg.sub1, %3, %subreg.sub2, %2, %subreg.sub3, %10, %subreg.sub4, %9, %subreg.sub5, %8, %subreg.sub6, %7, %subreg.sub7
+    S_ENDPGM 0, implicit %11
+...
+---
+# The low half may come from the later load; offsets follow the halves.
+# CHECK-LABEL: name: swapped_order
+# CHECK: DS_READ_B256_INVARIANT_PSEUDO %0, 48, 16, implicit $exec
+name: swapped_order
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0
+    %0:vgpr_32 = COPY $vgpr0
+    %1:av_128_align2 = DS_READ_B128_gfx9 %0, 16, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %2:av_128_align2 = DS_READ_B128_gfx9 %0, 48, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %3:av_256_align2 = REG_SEQUENCE %2, %subreg.sub0_sub1_sub2_sub3, %1, %subreg.sub4_sub5_sub6_sub7
+    S_ENDPGM 0, implicit %3
+...
+---
+# Not invariant: LDS may change, keep the loads.
+# CHECK-LABEL: name: not_invariant
+# CHECK-NOT: DS_READ_B256_INVARIANT_PSEUDO
+# CHECK: REG_SEQUENCE
+name: not_invariant
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0
+    %0:vgpr_32 = COPY $vgpr0
+    %1:av_128_align2 = DS_READ_B128_gfx9 %0, 16, 0, implicit $exec :: (load (s128), addrspace 3)
+    %2:av_128_align2 = DS_READ_B128_gfx9 %0, 48, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %3:av_256_align2 = REG_SEQUENCE %1, %subreg.sub0_sub1_sub2_sub3, %2, %subreg.sub4_sub5_sub6_sub7
+    S_ENDPGM 0, implicit %3
+...
+---
+# CHECK-LABEL: name: volatile_load
+# CHECK-NOT: DS_READ_B256_INVARIANT_PSEUDO
+# CHECK: REG_SEQUENCE
+name: volatile_load
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0
+    %0:vgpr_32 = COPY $vgpr0
+    %1:av_128_align2 = DS_READ_B128_gfx9 %0, 16, 0, implicit $exec :: (volatile invariant load (s128), addrspace 3)
+    %2:av_128_align2 = DS_READ_B128_gfx9 %0, 48, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %3:av_256_align2 = REG_SEQUENCE %1, %subreg.sub0_sub1_sub2_sub3, %2, %subreg.sub4_sub5_sub6_sub7
+    S_ENDPGM 0, implicit %3
+...
+---
+# Different address registers: not a single rematerializable instruction.
+# CHECK-LABEL: name: different_address
+# CHECK-NOT: DS_READ_B256_INVARIANT_PSEUDO
+# CHECK: REG_SEQUENCE
+name: different_address
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0, $vgpr1
+    %0:vgpr_32 = COPY $vgpr0
+    %4:vgpr_32 = COPY $vgpr1
+    %1:av_128_align2 = DS_READ_B128_gfx9 %0, 16, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %2:av_128_align2 = DS_READ_B128_gfx9 %4, 48, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %3:av_256_align2 = REG_SEQUENCE %1, %subreg.sub0_sub1_sub2_sub3, %2, %subreg.sub4_sub5_sub6_sub7
+    S_ENDPGM 0, implicit %3
+...
+---
+# A half with another use cannot be folded away.
+# CHECK-LABEL: name: extra_use
+# CHECK-NOT: DS_READ_B256_INVARIANT_PSEUDO
+# CHECK: REG_SEQUENCE
+name: extra_use
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0
+    %0:vgpr_32 = COPY $vgpr0
+    %1:av_128_align2 = DS_READ_B128_gfx9 %0, 16, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %2:av_128_align2 = DS_READ_B128_gfx9 %0, 48, 0, implicit $exec :: (invariant load (s128), addrspace 3)
+    %3:av_256_align2 = REG_SEQUENCE %1, %subreg.sub0_sub1_sub2_sub3, %2, %subreg.sub4_sub5_sub6_sub7
+    S_ENDPGM 0, implicit %3, implicit %1
+...
diff --git a/llvm/test/CodeGen/AMDGPU/lds-dma-waitcnt-invariant-load.ll b/llvm/test/CodeGen/AMDGPU/lds-dma-waitcnt-invariant-load.ll
new file mode 100644
index 000000000000..3e9bb24d1e59
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/lds-dma-waitcnt-invariant-load.ll
@@ -0,0 +1,52 @@
+; RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 < %s | FileCheck %s --check-prefixes=CHECK,SKIP
+; RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -amdgpu-waitcnt-invariant-lds-skip-dma=false < %s | FileCheck %s --check-prefixes=CHECK,NOSKIP
+
+; LDS loads through a pointer without alias information must normally wait for
+; any in-flight LDS DMA. A load marked !invariant.load reads memory that does not
+; change, so it cannot observe the DMA and SIInsertWaitcnts does not wait.
+
+@lds.dma = internal addrspace(3) global [64 x float] poison, align 16
+
+declare void @llvm.amdgcn.raw.buffer.load.lds(<4 x i32> %rsrc, ptr addrspace(3) nocapture, i32 %size, i32 %voffset, i32 %soffset, i32 %offset, i32 %aux)
+
+; CHECK-LABEL: invariant_lds_load_after_dma:
+; CHECK:       buffer_load_dword v{{[0-9]+}}, s[{{[0-9]+:[0-9]+}}], 0 offen lds
+; SKIP-NOT:    s_waitcnt vmcnt
+; NOSKIP:      s_waitcnt vmcnt(0)
+; CHECK:       ds_read_b32
+define amdgpu_kernel void @invariant_lds_load_after_dma(<4 x i32> %rsrc, i32 %voff, ptr addrspace(3) %q, ptr addrspace(1) %out) {
+  call void @llvm.amdgcn.raw.buffer.load.lds(<4 x i32> %rsrc, ptr addrspace(3) @lds.dma, i32 4, i32 %voff, i32 0, i32 0, i32 0)
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %p = getelementptr float, ptr addrspace(3) %q, i32 %tid
+  %v = load float, ptr addrspace(3) %p, align 4, !invariant.load !0
+  store float %v, ptr addrspace(1) %out, align 4
+  ret void
+}
+
+; CHECK-LABEL: plain_lds_load_after_dma:
+; CHECK:       buffer_load_dword v{{[0-9]+}}, s[{{[0-9]+:[0-9]+}}], 0 offen lds
+; CHECK:       s_waitcnt vmcnt(0)
+; CHECK:       ds_read_b32
+define amdgpu_kernel void @plain_lds_load_after_dma(<4 x i32> %rsrc, i32 %voff, ptr addrspace(3) %q, ptr addrspace(1) %out) {
+  call void @llvm.amdgcn.raw.buffer.load.lds(<4 x i32> %rsrc, ptr addrspace(3) @lds.dma, i32 4, i32 %voff, i32 0, i32 0, i32 0)
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %p = getelementptr float, ptr addrspace(3) %q, i32 %tid
+  %v = load float, ptr addrspace(3) %p, align 4
+  store float %v, ptr addrspace(1) %out, align 4
+  ret void
+}
+
+; A uniform invariant LDS load must stay a DS load: SMEM cannot read LDS.
+; CHECK-LABEL: uniform_invariant_lds_load:
+; CHECK:       ds_read_b32
+; CHECK:       s_endpgm
+define amdgpu_kernel void @uniform_invariant_lds_load(i32 %i, ptr addrspace(3) %q, ptr addrspace(1) %out) {
+  %p = getelementptr float, ptr addrspace(3) %q, i32 %i
+  %v = load float, ptr addrspace(3) %p, align 4, !invariant.load !0
+  store float %v, ptr addrspace(1) %out, align 4
+  ret void
+}
+
+declare i32 @llvm.amdgcn.workitem.id.x()
+
+!0 = !{}
