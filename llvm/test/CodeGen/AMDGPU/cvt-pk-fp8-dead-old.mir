# Conservatively reject conversions separated by an EXEC change.
---
name: exec_changes
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: exec_changes
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    ; CHECK-NEXT: [[V_CVT_PK_FP8_F32_e64_:%[0-9]+]]:vgpr_32 = V_CVT_PK_FP8_F32_e64 0, [[COPY]], 0, [[COPY1]], [[V_MOV_B32_e32_]], 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $exec = S_MOV_B64 1
    ; CHECK-NEXT: [[V_CVT_PK_FP8_F32_e64_1:%[0-9]+]]:vgpr_32 = V_CVT_PK_FP8_F32_e64 8, [[COPY]], 0, [[COPY1]], [[V_CVT_PK_FP8_F32_e64_]], 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_CVT_PK_FP8_F32_e64_1]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    %3:vgpr_32 = V_CVT_PK_FP8_F32_e64 0, %0, 0, %1, %2, 0, implicit $mode, implicit $exec
    $exec = S_MOV_B64 1
    %4:vgpr_32 = V_CVT_PK_FP8_F32_e64 8, %0, 0, %1, %3, 0, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %4
...

# The fold does not analyze execution masks across basic blocks.
---
name: different_block
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: different_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
  ; CHECK-NEXT:   [[V_CVT_PK_FP8_F32_e64_:%[0-9]+]]:vgpr_32 = V_CVT_PK_FP8_F32_e64 0, [[COPY]], 0, [[COPY1]], [[V_MOV_B32_e32_]], 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[V_CVT_PK_FP8_F32_e64_1:%[0-9]+]]:vgpr_32 = V_CVT_PK_FP8_F32_e64 8, [[COPY]], 0, [[COPY1]], [[V_CVT_PK_FP8_F32_e64_]], 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[V_CVT_PK_FP8_F32_e64_1]]
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    %3:vgpr_32 = V_CVT_PK_FP8_F32_e64 0, %0, 0, %1, %2, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.1
  bb.1:
    %4:vgpr_32 = V_CVT_PK_FP8_F32_e64 8, %0, 0, %1, %3, 0, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %4
...

