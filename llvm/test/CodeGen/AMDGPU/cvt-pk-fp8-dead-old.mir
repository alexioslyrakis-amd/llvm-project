    ; CHECK-NEXT: [[V_CVT_PK_BF8_F32_e64_1:%[0-9]+]]:vgpr_32 = V_CVT_PK_BF8_F32_e64 0, [[COPY2]], 0, [[COPY3]], [[V_CVT_PK_BF8_F32_e64_]], 0, implicit $mode, implicit $exec
