# A single consumer preserving the old half prevents the fold.
---
name: one_user_preserves_half
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: one_user_preserves_half
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vgpr_32 = COPY $vgpr3
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    ; CHECK-NEXT: [[V_CVT_PK_FP8_F32_e64_:%[0-9]+]]:vgpr_32 = V_CVT_PK_FP8_F32_e64 0, [[COPY]], 0, [[COPY1]], [[V_MOV_B32_e32_]], 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: [[V_CVT_PK_FP8_F32_e64_1:%[0-9]+]]:vgpr_32 = V_CVT_PK_FP8_F32_e64 8, [[COPY2]], 0, [[COPY3]], [[V_CVT_PK_FP8_F32_e64_]], 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: [[V_CVT_PK_BF8_F32_e64_:%[0-9]+]]:vgpr_32 = V_CVT_PK_BF8_F32_e64 0, [[COPY2]], 0, [[COPY3]], [[V_CVT_PK_FP8_F32_e64_]], 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_CVT_PK_FP8_F32_e64_1]], implicit [[V_CVT_PK_BF8_F32_e64_]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = COPY $vgpr2
    %3:vgpr_32 = COPY $vgpr3
    %4:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    %5:vgpr_32 = V_CVT_PK_FP8_F32_e64 0, %0, 0, %1, %4, 0, implicit $mode, implicit $exec
    %6:vgpr_32 = V_CVT_PK_FP8_F32_e64 8, %2, 0, %3, %5, 0, implicit $mode, implicit $exec
    %7:vgpr_32 = V_CVT_PK_BF8_F32_e64 0, %2, 0, %3, %5, 0, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %6, implicit %7
...

