# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=machine-sink -amdgpu-sched-barrier-blocks-code-motion -verify-machineinstrs -o - %s | FileCheck %s

# MachineSink must not move an instruction out of its block past a
# SCHED_BARRIER 0 that follows it; without the fence it sinks as usual.

---
# CHECK-LABEL: name: fenced
# CHECK:       bb.0:
# CHECK:         %{{[0-9]+}}:vgpr_32 = nofpexcept V_ADD_F32_e32 %0, %1, implicit $mode, implicit $exec
# CHECK-NEXT:    SCHED_BARRIER 0
name: fenced
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1, $vgpr2_vgpr3
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sreg_64 = COPY $sgpr0_sgpr1
    %4:vreg_64_align2 = COPY $vgpr2_vgpr3
    %3:vgpr_32 = nofpexcept V_ADD_F32_e32 %0, %1, implicit $mode, implicit $exec
    SCHED_BARRIER 0
    S_BARRIER
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.1, implicit $vcc
    S_BRANCH %bb.2
  bb.1:
    successors: %bb.2
    GLOBAL_STORE_DWORD %4, %3, 0, 0, implicit $exec
    S_BRANCH %bb.2
  bb.2:
    S_ENDPGM 0
...
---
# CHECK-LABEL: name: unfenced
# CHECK:       bb.1:
# CHECK:         %{{[0-9]+}}:vgpr_32 = nofpexcept V_ADD_F32_e32 %0, %1, implicit $mode, implicit $exec
# CHECK-NEXT:    GLOBAL_STORE_DWORD
name: unfenced
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1, $vgpr2_vgpr3
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sreg_64 = COPY $sgpr0_sgpr1
    %4:vreg_64_align2 = COPY $vgpr2_vgpr3
    %3:vgpr_32 = nofpexcept V_ADD_F32_e32 %0, %1, implicit $mode, implicit $exec
    S_BARRIER
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.1, implicit $vcc
    S_BRANCH %bb.2
  bb.1:
    successors: %bb.2
    GLOBAL_STORE_DWORD %4, %3, 0, 0, implicit $exec
    S_BRANCH %bb.2
  bb.2:
    S_ENDPGM 0
...
